{
  "description": "ECC deterministic guardrails selected by stack. ECC's SessionStart, PreCompact, session summary, continuous-learning, cost and notification hooks are not registered: memory belongs to rewire.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "description": "ECC Bash preflight: block --no-verify, tmux and git push reminders, commit quality, GateGuard",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/stack-hook.js",
              "scripts/hooks/plugin-hook-bootstrap.js",
              "node",
              "scripts/hooks/pre-bash-dispatcher.js"
            ]
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "description": "ECC config protection: stop edits that weaken linter or formatter configs",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/stack-hook.js",
              "scripts/hooks/plugin-hook-bootstrap.js",
              "node",
              "scripts/hooks/run-with-flags.js",
              "pre:config-protection",
              "scripts/hooks/config-protection.js",
              "standard,strict"
            ],
            "timeoutMs": 5000
          }
        ]
      },
      {
        "matcher": ".*",
        "description": "ECC Hookify: project-local rules written with /stack:hookify",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/stack-hook.js",
              "scripts/hooks/plugin-hook-bootstrap.js",
              "node",
              "scripts/hooks/run-with-flags.js",
              "pre:hookify-runtime",
              "scripts/hooks/hookify-runtime.js",
              "minimal,standard,strict"
            ],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "description": "ECC Hookify prompt rules",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/stack-hook.js",
              "scripts/hooks/plugin-hook-bootstrap.js",
              "node",
              "scripts/hooks/run-with-flags.js",
              "prompt:hookify-runtime",
              "scripts/hooks/hookify-runtime.js",
              "minimal,standard,strict"
            ],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "description": "ECC post-tool checks: quality gate, console.log warning, PR logger, Hookify",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/stack-hook.js",
              "scripts/hooks/posttooluse-dispatcher.js",
              "sync"
            ],
            "timeoutMs": 30000
          },
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/stack-hook.js",
              "scripts/hooks/posttooluse-dispatcher.js",
              "async"
            ],
            "timeoutMs": 45000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "description": "ECC end-of-turn checks: Hookify completion rules, format and typecheck, console.log audit",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/stack-hook.js",
              "scripts/hooks/lifecycle-hook-bootstrap.js",
              "stop:hookify-runtime",
              "scripts/hooks/hookify-runtime.js",
              "minimal,standard,strict",
              "10000"
            ],
            "timeoutMs": 10000
          },
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/stack-hook.js",
              "scripts/hooks/lifecycle-hook-bootstrap.js",
              "stop:format-typecheck",
              "scripts/hooks/stop-format-typecheck.js",
              "standard,strict",
              "300000"
            ],
            "timeoutMs": 300000
          },
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/stack-hook.js",
              "scripts/hooks/lifecycle-hook-bootstrap.js",
              "stop:check-console-log",
              "scripts/hooks/check-console-log.js",
              "standard,strict",
              "30000"
            ]
          }
        ]
      }
    ]
  }
}
