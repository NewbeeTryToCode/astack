{
  "plugin": "stack",
  "out": "plugins/stack",
  "overlay": "src",
  "command_remap": {
    "code-review": "interrogate",
    "react-review": "interrogate",
    "pr": "poteto-mode",
    "prp-pr": "poteto-mode",
    "prp-implement": "poteto-mode",
    "prp-plan": "plan",
    "prp-prd": "plan-prd",
    "prp-commit": "poteto-mode",
    "plan-canvas": "plan"
  },
  "licenses": {
    "pstack": { "source": "cursor-plugins", "path": "pstack/LICENSE" },
    "cursor-team-kit": { "source": "cursor-plugins", "path": "cursor-team-kit/LICENSE" },
    "ecc": { "source": "ecc", "path": "LICENSE" }
  },
  "entries": [
    {
      "why": "pstack owns judgment, verification, validation and the poteto-mode playbooks",
      "source": "cursor-plugins",
      "base": "harness/pstack/claude-code",
      "include": ["README.md", "skills/**", "agents/**", "docs/**"]
    },
    {
      "why": "cursor-team-kit skills that pstack routes to (deslop, control-cli, control-ui) plus its verification and CI helpers",
      "source": "cursor-plugins",
      "base": "cursor-team-kit",
      "inject_adapter": true,
      "include": [
        "skills/deslop/**",
        "skills/control-cli/**",
        "skills/control-ui/**",
        "skills/verify-this/**",
        "skills/run-smoke-tests/**",
        "skills/thermo-nuclear-code-quality-review/**",
        "skills/fix-ci/**",
        "skills/loop-on-ci/**",
        "skills/fix-merge-conflicts/**",
        "skills/check-compiler-errors/**",
        "agents/thermo-nuclear-code-quality-review.md",
        "agents/ci-watcher.md"
      ]
    },
    {
      "why": "ECC owns planning, design references, language specialists, security and deterministic hooks",
      "source": "ecc",
      "base": "",
      "rewrite_commands": true,
      "include": [
        "commands/plan.md",
        "docs/PLAN-PRD-PATTERN.md",
        "docs/capability-surface-selection.md",
        "commands/plan-prd.md",
        "commands/build-fix.md",
        "commands/rust-build.md",
        "commands/rust-review.md",
        "commands/rust-test.md",
        "commands/python-review.md",
        "commands/update-docs.md",
        "commands/update-codemaps.md",
        "commands/hookify.md",
        "commands/hookify-configure.md",
        "commands/hookify-help.md",
        "commands/hookify-list.md",

        "agents/planner.md",
        "agents/code-architect.md",
        "agents/code-explorer.md",
        "agents/docs-lookup.md",
        "agents/doc-updater.md",
        "agents/build-error-resolver.md",
        "agents/rust-reviewer.md",
        "agents/rust-build-resolver.md",
        "agents/python-reviewer.md",
        "agents/typescript-reviewer.md",
        "agents/database-reviewer.md",
        "agents/security-reviewer.md",
        "agents/silent-failure-hunter.md",
        "agents/type-design-analyzer.md",
        "agents/performance-optimizer.md",
        "agents/pytorch-build-resolver.md",
        "agents/mle-reviewer.md",
        "agents/rag-pipeline-reviewer.md",
        "agents/conversation-analyzer.md",

        "skills/architecture-decision-records/**",
        "skills/api-design/**",
        "skills/hexagonal-architecture/**",
        "skills/backend-patterns/**",
        "skills/error-handling/**",
        "skills/database-migrations/**",
        "skills/postgres-patterns/**",
        "skills/docker-patterns/**",
        "skills/deployment-patterns/**",
        "skills/rust-patterns/**",
        "skills/rust-testing/**",
        "skills/python-patterns/**",
        "skills/python-testing/**",
        "skills/pytorch-patterns/**",
        "skills/typescript-patterns/**",
        "skills/security-review/**",
        "skills/security-scan/**",
        "skills/mcp-server-patterns/**",
        "skills/hookify-rules/**",
        "skills/search-first/**",
        "skills/documentation-lookup/**",
        "skills/mle-workflow/**",
        "skills/eval-harness/**",

        "rules/common/coding-style.md",
        "rules/common/hooks.md",
        "rules/common/patterns.md",
        "rules/common/security.md",
        "rules/common/testing.md",
        "rules/rust/**",
        "rules/python/**",
        "rules/typescript/**"
      ]
    },
    {
      "why": "ECC hook runtime: the selected hook entry points and everything they require",
      "source": "ecc",
      "base": "",
      "js_closure": [
        "scripts/hooks/plugin-hook-bootstrap.js",
        "scripts/hooks/lifecycle-hook-bootstrap.js",
        "scripts/hooks/run-with-flags.js",
        "scripts/hooks/pre-bash-dispatcher.js",
        "scripts/hooks/config-protection.js",
        "scripts/hooks/posttooluse-dispatcher.js",
        "scripts/hooks/stop-format-typecheck.js",
        "scripts/hooks/check-console-log.js",
        "scripts/hooks/hookify-runtime.js"
      ]
    }
  ]
}
